<Window x:Class="InsuranceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оценка платежеспособности страховых компаний" 
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Оценка платежеспособности страховых компаний" 
                           FontSize="18" FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           Padding="15,10,15,5"/>
                <TextBlock Text="Система управления и анализа финансового состояния страховых организаций Республики Беларусь" 
                           FontSize="12" 
                           Foreground="#ECF0F1" 
                           HorizontalAlignment="Center" 
                           Padding="15,0,15,10"/>
            </StackPanel>
        </Border>

        <!-- Информационная панель -->
        <Border Grid.Row="1" Background="#34495E" CornerRadius="5" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="#27AE60" CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                    <TextBlock Text="Платежеспособна" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
                <TextBlock Text=" - " Foreground="White" FontSize="11" Margin="0,0,10,0"/>
                <Border Background="#E74C3C" CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                    <TextBlock Text="Не платежеспособна" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
                <TextBlock Text=" - " Foreground="White" FontSize="11" Margin="0,0,10,0"/>
                <Border Background="#3498DB" CornerRadius="3" Padding="5,2">
                    <TextBlock Text="Активы - Обязательства > 16% от годовой премии" Foreground="White" FontSize="11"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Таблица с компаниями -->
        <DataGrid x:Name="dgCompanies" 
                  Grid.Row="2" 
                  AutoGenerateColumns="False"  
                  IsReadOnly="True"
                  AlternatingRowBackground="#F9F9F9"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  FontSize="13"
                  Margin="0,0,0,10">

            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3498DB"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название компании" Binding="{Binding Name}" Width="250"/>
                <DataGridTextColumn Header="УНП" Binding="{Binding Unp}" Width="120"/>
                <DataGridTextColumn Header="Юридический адрес" Binding="{Binding LegalAddress}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя панель с кнопками -->
        <Border Grid.Row="3" Background="#2C3E50" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Статистика -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊 Всего компаний: " Foreground="#ECF0F1" FontSize="12"/>
                    <TextBlock x:Name="tbCompaniesCount" Text="0" Foreground="#3498DB" FontSize="12" FontWeight="Bold"/>
                </StackPanel>

                <!-- Кнопки управления -->
                <StackPanel Orientation="Horizontal" Margin="144,0,0,0">


                    <Button x:Name="btnAdd" 
                            Content="➕ Добавить" 
                            Width="100" Height="30" 
                            Margin="0,0,10,0"
                            Background="#27AE60" 
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnAdd_Click"/>

                    <Button x:Name="btnEdit" 
                            Content="✏️ Редактировать" 
                            Width="110" Height="30" 
                            Margin="0,0,10,0"
                            Background="#F39C12" 
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnEdit_Click"/>

                    <Button x:Name="btnDelete" 
                            Content="🗑️ Удалить" 
                            Width="100" Height="30" 
                            Margin="0,0,10,0"
                            Background="#E74C3C" 
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnDelete_Click"/>

                    <Button x:Name="btnContracts" 
                            Content="📋 Договоры и активы" 
                            Width="150" Height="30" 
                            Margin="0,0,10,0"
                            Background="#8E44AD" 
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnContracts_Click"/>
                    <Button x:Name="btnSolvency" 
                            Content="📊 Платежеспособность" 
                            Width="155" Height="30"
                            Margin="0,0,10,0"
                            Background="#1ABC9C" 
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnSolvency_Click"/>
                    <Button x:Name="btnReport" 
                            Content="📄 Создать отчёт" 
                            Width="130" Height="30"
                            Margin="0,0,10,0"
                            Background="#2980B9" 
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>