<Window x:Class="InsuranceApp.CompanyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование компании" 
        Height="350" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="139"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Информация о страховой компании" 
                   FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Left" 
                   Margin="61,0,0,20" Width="288"/>

        <!-- Название компании -->
        <Label Grid.Row="1" Grid.Column="0" 
               Content="Название компании:" 
               FontWeight="Bold" 
               VerticalAlignment="Center" Height="30"/>
        <TextBox x:Name="txtName" 
                 Grid.Row="1" Grid.Column="1" Margin="0,5,0,5"
                 VerticalContentAlignment="Center"/>

        <!-- УНП (Учетный номер плательщика) -->
        <Label Grid.Row="2" Grid.Column="0" 
               Content="УНП:" 
               FontWeight="Bold" 
               VerticalAlignment="Center" Height="26"/>
        <TextBox x:Name="txtUnp" 
                 Grid.Row="2" Grid.Column="1" Margin="0,5,0,5"
                 VerticalContentAlignment="Center"
                 MaxLength="20"/>

        <!-- Юридический адрес -->
        <Label Grid.Row="2" Grid.Column="0" 
               Content="Юридический адрес:" 
               FontWeight="Bold" 
               VerticalAlignment="Top" Height="26" Margin="0,40,0,0" Grid.RowSpan="2"/>
        <TextBox x:Name="txtAddress" 
                 Grid.Row="3" Grid.Column="1" Margin="0,5,0,5"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- Пустая строка для отступа -->
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,22,0,21"/>

        <!-- Кнопки OK/Cancel -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    Margin="95,10,0,0" Width="220">
            <Button x:Name="btnOk" 
                    Content="OK" 
                    Width="100" Height="30" 
                    Margin="0,0,20,0"
                    Background="#4CAF50" 
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnOk_Click"/>
            <Button x:Name="btnCancel" 
                    Content="Отмена" 
                    Width="100" Height="30"
                    Background="#F44336" 
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>