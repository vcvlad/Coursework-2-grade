<Window x:Class="InsuranceApp.ContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Данные страховой компании" 
        Height="650" Width="1100"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и информация -->
        <Border Grid.Row="0" Background="#2980B9" CornerRadius="5" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <TextBlock x:Name="tbCompanyName" 
                           Text="Страховая компания" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Управление договорами, активами и обязательствами" 
                           FontSize="12" 
                           Foreground="#ECF0F1"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Табы с данными -->
        <TabControl Grid.Row="1" Margin="0,0,0,10">
            <!-- Вкладка 1: Договоры страхования -->
            <TabItem Header="📄 Договоры страхования">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Добавить договор" 
                                Width="140" Height="30" 
                                Margin="0,0,10,0"
                                Background="#27AE60" 
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnAddContract_Click"/>
                        <Button Content="✏️ Редактировать" 
                                Width="120" Height="30" 
                                Margin="0,0,10,0"
                                Background="#F39C12" 
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnEditContract_Click"/>
                        <Button Content="🗑️ Удалить" 
                                Width="100" Height="30"
                                Background="#E74C3C" 
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnDeleteContract_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgContracts" 
                              Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9F9F9"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Margin="0,0,0,10"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Вид страхования" Binding="{Binding TypeName}" Width="150"/>
                            <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}" Width="100"/>
                            <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}" Width="100"/>
                            <DataGridTextColumn Header="Сумма премии (руб.)" Binding="{Binding PremiumAmount}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#ECF0F1" CornerRadius="5" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰 Общая сумма премий: " FontWeight="Bold"/>
                            <TextBlock x:Name="tbTotalPremium" Text="0 руб." Foreground="#27AE60" FontWeight="Bold"/>
                            <TextBlock Text="    |    📊 Количество договоров: " FontWeight="Bold" Margin="20,0,0,0"/>
                            <TextBlock x:Name="tbContractsCount" Text="0" Foreground="#2980B9" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Активы компании -->
            <TabItem Header="💰 Активы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Добавить актив" 
                                Width="140" Height="30" 
                                Margin="0,0,10,0"
                                Background="#27AE60" 
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnAddAsset_Click"/>
                        <Button Content="✏️ Редактировать" 
                                Width="120" Height="30" 
                                Margin="0,0,10,0"
                                Background="#F39C12" 
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnEditAsset_Click"/>
                        <Button Content="🗑️ Удалить" 
                                Width="100" Height="30"
                                Background="#E74C3C" 
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnDeleteAsset_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgAssets" 
                              Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9F9F9"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Margin="0,0,0,10"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding AssetDate}" Width="100"/>
                            <DataGridTextColumn Header="Тип актива" Binding="{Binding AssetType}" Width="200"/>
                            <DataGridTextColumn Header="Сумма (руб.)" Binding="{Binding Amount}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#ECF0F1" CornerRadius="5" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💎 Общая сумма активов: " FontWeight="Bold"/>
                            <TextBlock x:Name="tbTotalAssets" Text="0 руб." Foreground="#27AE60" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Обязательства (резервы) -->
            <TabItem Header="⚠️ Обязательства">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Добавить обязательство" 
                                Width="160" Height="30" 
                                Margin="0,0,10,0"
                                Background="#27AE60" 
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnAddLiability_Click"/>
                        <Button Content="✏️ Редактировать" 
                                Width="120" Height="30" 
                                Margin="0,0,10,0"
                                Background="#F39C12" 
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnEditLiability_Click"/>
                        <Button Content="🗑️ Удалить" 
                                Width="100" Height="30"
                                Background="#E74C3C" 
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnDeleteLiability_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgLiabilities" 
                              Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9F9F9"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Margin="0,0,0,10"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding LiabilityDate}" Width="100"/>
                            <DataGridTextColumn Header="Тип резерва" Binding="{Binding ReserveType}" Width="200"/>
                            <DataGridTextColumn Header="Сумма (руб.)" Binding="{Binding Amount}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#ECF0F1" CornerRadius="5" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📉 Общая сумма обязательств: " FontWeight="Bold"/>
                            <TextBlock x:Name="tbTotalLiabilities" Text="0 руб." Foreground="#E74C3C" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Динамика премий (ГРАФИК) -->
            <TabItem Header="📈 Динамика премий">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#3498DB" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="Динамика страховых премий по месяцам" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- График динамики премий -->
                    <oxy:PlotView x:Name="PremiumChart" 
                                  Grid.Row="1" 
                                  Model="{Binding}" 
                                  Margin="0,0,0,10"/>

                    <!-- Краткая статистика под графиком -->
                    <Border Grid.Row="2" Background="#ECF0F1" CornerRadius="5" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📊 " FontSize="14"/>
                            <TextBlock x:Name="tbMaxMonth" Text="" Foreground="#2980B9" FontWeight="Bold"/>
                            <TextBlock Text=" — максимальная премия" Margin="0,0,15,0" FontSize="12"/>
                            <TextBlock Text="📉 " FontSize="14"/>
                            <TextBlock x:Name="tbMinMonth" Text="" Foreground="#E74C3C" FontWeight="Bold"/>
                            <TextBlock Text=" — минимальная премия" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="#34495E" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="ℹ️ Данные автоматически обновляются при добавлении, редактировании и удалении" 
                           Foreground="#ECF0F1" 
                           FontSize="11" 
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" 
                        Content="🔄 Обновить" 
                        Width="100" Height="30"
                        Background="#3498DB" 
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnRefresh_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>